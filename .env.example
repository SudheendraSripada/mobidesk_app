# MobiDesk Supabase and Guacamole Configuration
# Copy this file to .env and fill in your project credentials.
# NEVER commit the real .env file with secrets to git!

# Supabase Auth & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Apache Guacamole Web Base URL (e.g. running on your Ubuntu 24.04 server)
# Note: For Android emulator use http://10.0.2.2:8080/guacamole or your LAN IP http://192.168.1.50:8080/guacamole
GUACAMOLE_BASE_URL=http://192.168.1.100:8080/guacamole
